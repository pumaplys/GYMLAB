# =============================================================
# GYMLAB — plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores.
# .env esta en .gitignore: NUNCA se sube al repositorio.
# =============================================================

NODE_ENV=development

# --- Base de datos (PostgreSQL) --------------------------------
# Hay DOS conexiones a proposito, y no son intercambiables.
#
# Rol propietario: migraciones, seed y aplicacion de politicas.
# Es superusuario, asi que IGNORA Row Level Security.
# La API NUNCA debe usar esta.
DATABASE_URL=postgresql://gymlab:gymlab@localhost:5432/gymlab

# Rol de la aplicacion: sin privilegios especiales, sujeto a RLS.
# Es la que usan la API en ejecucion y los tests de aislamiento.
DATABASE_URL_APP=postgresql://gymlab_app:gymlab_app@localhost:5432/gymlab

# Contrasena con la que `pnpm db:migrate` crea/actualiza el rol gymlab_app.
# Debe coincidir con la de DATABASE_URL_APP. En produccion, un secreto real.
APP_DB_PASSWORD=gymlab_app

# --- API -------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001

# Secreto de firma de Better Auth. Minimo 32 caracteres.
# En produccion: un secreto real, distinto por entorno y rotable.
AUTH_SECRET=desarrollo-cambia-esto-por-un-secreto-de-verdad

# Codigo que exige /v1/auth/register-gym mientras estemos en piloto.
# Se sustituira por el flujo de pago cuando entre Stripe.
PLATFORM_INVITE_CODE=gymlab-piloto-2026

# Origenes permitidos por CORS, separados por comas.
# Lista blanca y nunca `*`: el transporte por cookie exige `credentials: true`,
# y el navegador rechaza esa combinacion con comodin.
CORS_ORIGINS=http://localhost:3000

# --- Correo ----------------------------------------------------------
# URL del panel web. Es la BASE DE LOS ENLACES DE LOS CORREOS: invitacion,
# restablecer contrasena y verificar email apuntan aqui, no a la API.
WEB_APP_URL=http://localhost:3000

# Clave de Resend. OPCIONAL en desarrollo: sin ella, los correos se registran
# en consola y se puede recorrer el flujo completo sin cuenta de Resend.
# En PRODUCCION es obligatoria — el proceso no arranca sin ella.
# RESEND_API_KEY=re_...

# Remitente. Debe ser un dominio verificado en Resend: enviar desde un dominio
# sin verificar acaba en spam, que es peor que no enviar (nadie se entera).
EMAIL_FROM=GYMLAB <no-reply@localhost>

# --- Panel web -------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- App movil (Expo) ------------------------------------------
# En dispositivo fisico usa la IP de tu equipo, no localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Semilla de la que se derivan las claves de firma del QR de acceso (HKDF por gimnasio).
ACCESS_TOKEN_SECRET=desarrollo-semilla-de-acceso-cambiala-en-produccion
