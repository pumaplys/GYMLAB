{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "packages/config/**"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
      // El panel se exporta estatico, asi que esto NO se lee en produccion: se
      // incrusta en el paquete al construirlo. Por eso su valor por defecto es
      // la ruta relativa `/v1` â€” el mismo origen, que es el requisito de
      // despliegueâ€” y no un dominio que habria que acertar en cada entorno.
      //
      // Las tres de `NEXT_PUBLIC_PRESTADOR_*` son la identidad legal de quien
      // presta el servicio. NO estan en el codigo a proposito: el aviso legal y
      // la politica de privacidad las leen de aqui, asi que el nombre, el
      // domicilio y el identificador fiscal nunca entran en el repositorio.
      // Como el panel se exporta estatico, se incrustan AL CONSTRUIR: cambiar
      // quien responde ante una autoridad exige volver a construir, que es la
      // ceremonia que merece.
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_PRESTADOR_NOMBRE",
        "NEXT_PUBLIC_PRESTADOR_DOMICILIO",
        "NEXT_PUBLIC_PRESTADOR_NIF"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_APP",
        "AUTH_SECRET",
        "ACCESS_TOKEN_SECRET",
        "HEALTH_CONSENT_VERSION",
        "PLATFORM_INVITE_CODE",
        "API_URL",
        "API_PORT",
        "WEB_APP_URL",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      // Turborepo 2 usa modo de entorno estricto: una variable no declarada
      // aqui NO llega a la tarea. En local no se nota, porque los tests leen el
      // .env con dotenv; pero en CI no hay .env y los tests de aislamiento se
      // saltarian en silencio, que es peor que fallar.
      //
      // Van en la tarea y no en globalEnv para no meter la URL de la base de
      // datos en el hash de cache del build.
      //
      // AL ANADIR UNA VARIABLE A config/env.ts, anadela tambien aqui. Las que
      // tienen valor por defecto no rompen los tests, pero se ignoraria en
      // silencio lo que se configure en CI.
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_APP",
        "AUTH_SECRET",
        "ACCESS_TOKEN_SECRET",
        "HEALTH_CONSENT_VERSION",
        "PLATFORM_INVITE_CODE",
        "API_URL",
        "API_PORT",
        "WEB_APP_URL",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "RESEND_API_KEY",
        "EMAIL_FROM"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
