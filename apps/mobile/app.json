{
  "expo": {
    "name": "RINDA",
    "slug": "rinda",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rinda",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.gymlabfit.rinda",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tech.gymlabfit.rinda",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F12"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RINDA necesita la cámara para escanear carnés de acceso.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F12"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94dd2583-945c-4c4c-a37e-73bafbd60716"
      }
    },
    "owner": "pumaplysz"
  }
}
