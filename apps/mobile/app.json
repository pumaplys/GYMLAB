{
  "expo": {
    "name": "GYMLAB",
    "slug": "gymlab",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gymlab",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymlab.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.gymlab.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
