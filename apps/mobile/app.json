{
  "expo": {
    "name": "GYMLAB",
    "slug": "gymlab",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "gymlab",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymlab.app"
    },
    "android": {
      "package": "com.gymlab.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
