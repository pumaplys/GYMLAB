# A que API habla la app movil.
#
# DESDE UN TELEFONO, `localhost` NO VALE: el movil no es el ordenador. Hay que
# poner la IPv4 del PC en la red local, que se averigua asi:
#
#   Windows   ipconfig            -> "Direccion IPv4" del adaptador Wi-Fi
#   macOS     ipconfig getifaddr en0
#   Linux     hostname -I
#
# El puerto es el de la API de desarrollo (3001) y la ruta incluye la version.
# No es un secreto: `EXPO_PUBLIC_*` se INCRUSTA en el paquete de la app, asi
# que aqui no puede ir nada que si lo sea.
#
# Sin esta variable la app usa http://localhost:3001/v1 en desarrollo, que
# funciona en un emulador de escritorio pero no en un telefono.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001/v1
