{
  "name": "@gymlab/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente HTTP tipado de la API GYMLAB: cada respuesta se valida contra @gymlab/contracts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@gymlab/contracts": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gymlab/config": "workspace:*",
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
