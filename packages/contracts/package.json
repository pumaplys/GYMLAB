{
  "name": "@gymlab/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos compartidos: esquemas Zod y tipos del dominio GYMLAB",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gymlab/config": "workspace:*",
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  }
}
