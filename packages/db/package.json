{
  "name": "@gymlab/db",
  "version": "0.0.0",
  "private": true,
  "description": "Esquema Drizzle, migraciones y politicas RLS de GYMLAB",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./schema": {
      "import": { "types": "./dist/schema/index.d.ts", "default": "./dist/schema/index.js" },
      "require": { "types": "./dist/schema/index.d.cts", "default": "./dist/schema/index.cjs" }
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate && pnpm run rls",
    "rls": "tsx scripts/apply-rls.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@gymlab/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
