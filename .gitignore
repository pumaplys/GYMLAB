# Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
# `expo export --output-dir` acepta cualquier nombre, y `dist/` a secas no lo
# tapa: un `dist-ios` de 3 MB entro en un commit por esto.
dist-*/
build/
.next/
out/
*.tsbuildinfo
# Lo regenera Next.js en cada build; no debe editarse a mano.
next-env.d.ts

# Cache
.turbo/
.cache/
.eslintcache

# Expo
.expo/
.expo-shared/
*.jks
*.p12
*.key
*.mobileprovision

# Entorno — NUNCA subir secretos
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Tests
coverage/

# Editor / SO
.vscode/*
!.vscode/extensions.json
# Ajustes locales de Claude Code: rutas absolutas de cada maquina.
