# Expo / React Native (Metro) no resuelve bien los symlinks de pnpm.
# 'hoisted' genera un node_modules plano, como npm. Es un requisito practico
# para tener la app movil dentro del monorepo.
node-linker=hoisted

# Evita que un peer dependency mal declarado por un tercero bloquee el install.
strict-peer-dependencies=false
auto-install-peers=true
